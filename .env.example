# Copy to .env.local for local development (it is git-ignored).
# Real production secrets live ONLY in Vercel environment variables and GitHub Secrets.

# ---------- Local development ----------
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=8787

# Separate free *dev* Firebase project (never production).
# Without these, the public site still works with the built-in CV content, but /admin is disabled.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_B64=          # base64 of the dev service-account JSON
VITE_FIREBASE_API_KEY=                 # Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_AUTH_DOMAIN=             # <project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary: same free account for dev and prod; dev uploads go to the "portfolio-dev" folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio-dev

# Optional in dev: without a key, contact emails are printed in the terminal instead of sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=coral.bareket@gmail.com

# Turnstile: leave empty in dev to use Cloudflare's always-pass test keys.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Production only (Vercel env vars, phase 6) ----------
# NODE_ENV=production
# FIREBASE_PROJECT_ID / FIREBASE_SERVICE_ACCOUNT_B64 / VITE_FIREBASE_*   → the production project
# CLOUDINARY_FOLDER=portfolio
# RESEND_API_KEY=                     # required
# VITE_TURNSTILE_SITE_KEY / TURNSTILE_SECRET_KEY → real keys
# RATE_LIMIT_SALT=                    # long random string
