# Copy to .env.local for local development. Real secrets live ONLY in
# Vercel environment variables and GitHub Secrets, never in the repo.

# ---------- Local development (Firebase Emulator Suite) ----------
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=8787
FIREBASE_PROJECT_ID=demo-portfolio
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------- Production only (Vercel env vars), added in later phases ----------
# FIREBASE_PROJECT_ID=            # production Firebase project id
# FIREBASE_SERVICE_ACCOUNT_B64=   # base64 of the service-account JSON
# RESEND_API_KEY=                 # contact-form email notifications
# CONTACT_TO_EMAIL=               # where notifications are sent
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# TURNSTILE_SECRET_KEY=           # server-side CAPTCHA verification
# RATE_LIMIT_SALT=                # random string, hashes IPs for rate limiting
# VITE_TURNSTILE_SITE_KEY=        # public site key (build time)
# VITE_FIREBASE_API_KEY=          # public web config for admin Google sign-in (build time)
# VITE_FIREBASE_AUTH_DOMAIN=
