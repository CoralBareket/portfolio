# Copy to .env.production.local (git-ignored) and fill in. Used ONLY on your machine by:
#   pnpm setup:production      → creates the Vercel project and stores these on Vercel
#   pnpm tsx --env-file=.env.production.local scripts/seed.ts         → seed production content
#   pnpm tsx --env-file=.env.production.local scripts/grant-admin.ts <email>
# Nothing in here is ever committed.

# Vercel → Account settings → Tokens → Create (scope: your personal account)
VERCEL_TOKEN=
VERCEL_PROJECT_NAME=coralbareket

# Production Firebase project (NOT the dev one)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_B64=

# Resend → API Keys (sign up with coral.bareket@gmail.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=coral.bareket@gmail.com

# Cloudinary (same account as dev; production uploads go to the "portfolio" folder)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare Turnstile widget for coralbareket.vercel.app
TURNSTILE_SECRET_KEY=
